[Unit]
Description=Independent sorter lanes 1 and 2 plant model
After=network-online.target vfd@induct1.service vfd@induct2.service vfd@outbnd1.service vfd@outbnd2.service vfd@outbnd3.service
Wants=network-online.target

[Service]
Type=simple
User=kevin
WorkingDirectory=/home/kevin
ExecStart=/home/kevin/venv/bin/python /home/kevin/plant.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
